generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

/// 儲存所有 TWSE OpenAPI 的原始 JSON 回應，作為備份與重跑的基礎。
/// - dataset: 來源端點的 dataset 名稱，例如 "STOCK_DAY_ALL"。
model TwseRaw {
  id        BigInt   @id @default(autoincrement())
  dataset   String
  tradeDate DateTime @db.Date
  fetchedAt DateTime @default(now())
  payload   Json

  @@unique([dataset, tradeDate])
  @@map("twse_raw")
}

/// 正規化後的每日價量資料。
/// Change（漲跌價差）刻意不存：能從前後兩天存好的 close 算出來，不屬於「抓不到就永久消失」的資料。
/// 資料來源 (複數):
/// - /exchangeReport/STOCK_DAY_ALL (開、高、低、收、成交量、成交金額、成交筆數)
/// - /exchangeReport/STOCK_DAY_AVG_ALL (收、月均價)
model DailyPrice {
  symbol      String
  tradeDate   DateTime @db.Date
  open        Decimal? @db.Decimal(10, 4)
  high        Decimal? @db.Decimal(10, 4)
  low         Decimal? @db.Decimal(10, 4)
  close       Decimal? @db.Decimal(10, 4)
  volume      BigInt?
  turnover    BigInt?
  transaction BigInt?
  monthlyAvg  Decimal? @db.Decimal(10, 4)

  @@id([symbol, tradeDate])
  @@map("daily_price")
}

/// 正規化後的每日估值資料。與價格分開存，因為缺值模式不同。
/// 資料來源:
/// - /exchangeReport/BWIBBU_ALL (本益比、股價淨值比、殖利率)
model DailyValuation {
  symbol        String
  tradeDate     DateTime @db.Date
  peRatio       Decimal? @db.Decimal(10, 2)
  pbRatio       Decimal? @db.Decimal(10, 2)
  dividendYield Decimal? @db.Decimal(10, 2)

  @@id([symbol, tradeDate])
  @@map("daily_valuation")
}

/// 公發公司資產負債表-一般業
/// 資料來源:
/// - /opendata/t187ap07_X_ci
model QuarterlyBalanceSheet {
  symbol        String
  year          Int
  quarter       Int
  reportDate    DateTime @db.Date @map("report_date")

  currentAssets         BigInt?   @map("current_assets")
  nonCurrentAssets      BigInt?   @map("non_current_assets")
  totalAssets           BigInt?   @map("total_assets")
  currentLiabilities    BigInt?   @map("current_liabilities")
  nonCurrentLiabilities BigInt?   @map("non_current_liabilities")
  totalLiabilities      BigInt?   @map("total_liabilities")
  capitalStock          BigInt?   @map("capital_stock")
  equityVirtualCurrency BigInt?   @map("equity_virtual_currency")
  capitalSurplus        BigInt?   @map("capital_surplus")
  retainedEarnings      BigInt?   @map("retained_earnings")
  otherEquity           BigInt?   @map("other_equity")
  treasuryStock         BigInt?   @map("treasury_stock")
  equityToParent        BigInt?   @map("equity_to_parent")
  commonControlPredecessorEquity BigInt? @map("common_control_predecessor_equity")
  nonCommonControlPredecessorEquity BigInt? @map("non_common_control_predecessor_equity")
  nonControllingInterest            BigInt?   @map("non_controlling_interest")
  totalEquity                        BigInt?   @map("total_equity")
  sharesAwaitingCancellation         BigInt?   @map("shares_awaiting_cancellation")
  equivalentSharesFromPrepayments    BigInt?   @map("equivalent_shares_from_prepayments")
  treasurySharesHeldBySubs           BigInt?   @map("treasury_shares_held_by_subs")
  bookValuePerShare                  Decimal?  @db.Decimal(10, 2) @map("book_value_per_share")

  // Metadata for tracking record timestamps
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at")

  @@id([symbol, year, quarter])
  @@map("quarterly_balance_sheet")
}
